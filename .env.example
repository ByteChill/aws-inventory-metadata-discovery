# Copy to .env for local runs. Values point at the services in compose.yaml.
INVENTORY_ENVIRONMENT=local
INVENTORY_LOG_LEVEL=DEBUG
INVENTORY_PRIMARY_REGION=ap-east-1
INVENTORY_SCAN_REGIONS='["ap-east-1","eu-west-1","eu-west-2","us-east-1"]'
# queues are found by name: inventory-<environment>-scheduled / -ondemand
INVENTORY_DATABASE_URL=postgresql+psycopg://inventory:inventory@localhost:5432/inventory
INVENTORY_AWS_ENDPOINT_URL=http://localhost:5000

# boto3 does not read .env; export these first: set -a; source .env; set +a
AWS_ACCESS_KEY_ID=testing
AWS_SECRET_ACCESS_KEY=testing
AWS_DEFAULT_REGION=ap-east-1

BROKER_ADFS_IDP_URL=https://adfs.example.invalid/adfs/ls/IdpInitiatedSignOn.aspx?loginToRp=urn:amazon:webservices
BROKER_ADFS_CREDENTIALS_SECRET_ARN=arn:aws:secretsmanager:ap-east-1:123456789012:secret:inventory/local/adfs
BROKER_REDIS_URL=redis://localhost:6379/0
BROKER_KMS_KEY_ID=alias/inventory-local

PLANNER_ACCOUNT_DIRECTORY_FUNCTION_NAME=aws-inventory-account-directory
PLANNER_DELETED_RETENTION_DAYS=180

WORKER_REGION=ap-east-1
