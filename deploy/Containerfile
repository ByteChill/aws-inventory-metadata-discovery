# One target per component; build with deploy/build.sh <component>.
# Each image installs only its own extra from pyproject.toml. Platform: linux/amd64.

FROM ghcr.io/astral-sh/uv:0.13.5 AS uv

# --------------------------------------------------------------------------- web UI (api image)
# static files only: build on the host's own platform (esbuild crashes under amd64 emulation)
FROM --platform=$BUILDPLATFORM public.ecr.aws/docker/library/node:22-slim AS web
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY web/ ./
RUN npm run build

# --------------------------------------------------------------------------- Lambda images
FROM public.ecr.aws/lambda/python:3.12 AS lambda-base
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR ${LAMBDA_TASK_ROOT}
COPY pyproject.toml uv.lock ./

FROM lambda-base AS broker
RUN uv export --frozen --no-dev --no-emit-project --no-hashes --extra broker -o requirements.txt \
    && pip install --no-cache-dir -r requirements.txt --target "${LAMBDA_TASK_ROOT}" \
    && rm requirements.txt
COPY inventory/ ./inventory/
CMD ["inventory.handlers.broker_lambda.handler"]

FROM lambda-base AS planner
RUN uv export --frozen --no-dev --no-emit-project --no-hashes --extra planner -o requirements.txt \
    && pip install --no-cache-dir -r requirements.txt --target "${LAMBDA_TASK_ROOT}" \
    && rm requirements.txt
COPY inventory/ ./inventory/
CMD ["inventory.handlers.planner_lambda.handler"]

# --------------------------------------------------------------------------- ECS images
FROM public.ecr.aws/docker/library/python:3.12-slim AS ecs-base
COPY --from=uv /uv /usr/local/bin/uv
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN useradd --system --uid 10001 inventory

FROM ecs-base AS api
RUN uv export --frozen --no-dev --no-emit-project --no-hashes --extra api -o requirements.txt \
    && uv pip install --system --no-cache -r requirements.txt \
    && rm requirements.txt
COPY inventory/ ./inventory/
# the built UI is served at /ui/ (spec 10)
COPY --from=web /web/dist/ ./inventory/api/ui/
USER inventory
EXPOSE 8080
ENTRYPOINT ["python", "-m", "uvicorn", "--factory", "inventory.api.app:create_app", \
    "--host", "0.0.0.0", "--port", "8080", "--workers", "1", "--no-access-log"]

FROM ecs-base AS worker
RUN uv export --frozen --no-dev --no-emit-project --no-hashes --extra worker -o requirements.txt \
    && uv pip install --system --no-cache -r requirements.txt \
    && rm requirements.txt
# migrations ship with the worker: the migrate task runs `python -m alembic upgrade head`
COPY alembic.ini ./
COPY migrations/ ./migrations/
COPY inventory/ ./inventory/
USER inventory
ENTRYPOINT ["python", "-m", "inventory.handlers.worker"]
